# Copy to .env with `teslai init`, which fills generated values.
TESLAI_DOMAIN=teslai.example.com
TESLAI_TELEMETRY_HOST=telemetry.teslai.example.com
TESLAI_TELEMETRY_PORT=4443
TESLAI_SECRETS_DIR=./secrets
TESLAI_TIMEZONE=America/Chicago
# Containers run as this user so they can read secrets/ (set by teslai init)
TESLAI_UID=
TESLAI_GID=

DATABASE_URL=postgresql+psycopg://teslai:CHANGE_ME@localhost:5432/teslai
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_BASE=telemetry

# Tesla developer app (filled after `teslai tesla register`)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_VIN=
TESLA_REDIRECT_URI=
# vehicle-command proxy that signs config pushes; its CA to verify TLS
TESLA_PROXY_URL=https://localhost:4443
TESLA_PROXY_CA=

TESLAI_SESSION_SECRET=CHANGE_ME
