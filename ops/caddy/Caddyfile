# Public edge. Serves only the Tesla public key until owner login ships.
# The telemetry port is not proxied here: the car connects to fleet-telemetry
# directly with mTLS on its own port.
{$TESLAI_DOMAIN} {
	handle /.well-known/appspecific/com.tesla.3p.public-key.pem {
		root * /srv/tesla
		rewrite * /com.tesla.3p.public-key.pem
		header Content-Type application/x-pem-file
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
